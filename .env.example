# Copy to .env.local and fill in. Never commit real values.

# NextAuth / Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# Postgres connection string (Neon). Optional locally: without it, users live
# in an in-memory store that resets when the server restarts.
DATABASE_URL=

# https://newsapi.org/register (free Developer plan: 100 requests/day)
NEWS_API_KEY=

# https://www.themoviedb.org/settings/api (v4 "API Read Access Token" or v3 API key)
TMDB_API_KEY=

# Set to 1 to force bundled demo data for every source (used by E2E tests)
MOCK_APIS=
